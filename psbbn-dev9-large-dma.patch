-			HDDWriteFIFO();
+			// Ensure FIFO has data.
+			if (hddXfer && hddRead)
+				HDDWriteFIFO();
+
+			if (iopXfer)
+			{
+				// Perform DMA to IOP.
+				IOPReadFIFO();
+
+				// Refill FIFO after DMA. Recheck dmaReady because the first
